[
  { "id": "antioch-syria", "cn": "安提阿", "en": "Antioch of Syria", "modern": "今土耳其安塔基亚", "ll": [36.2021, 36.1606],
    "note": "叙利亚的安提阿。门徒称为「基督徒」是从这里起头（徒 11:26），保罗三次传道旅程皆由此出发并归回。" },
  { "id": "seleucia", "cn": "西流基", "en": "Seleucia Pieria", "modern": "今土耳其", "ll": [35.93, 36.10],
    "note": "安提阿的地中海港口，第一次旅程的起锚之地（徒 13:4）。" },
  { "id": "salamis", "cn": "撒拉米", "en": "Salamis", "modern": "今塞浦路斯", "ll": [35.1836, 33.8978],
    "note": "居比路东岸城市。保罗和巴拿巴在犹太人的各会堂里传讲神的道（徒 13:5）。" },
  { "id": "paphos", "cn": "帕弗", "en": "Paphos", "modern": "今塞浦路斯帕福斯", "ll": [34.7571, 32.4057],
    "note": "居比路罗马总督驻地。方伯士求保罗在此信主；遗址出土的马赛克与碑刻为这段历史提供了考古背景。" },
  { "id": "perga", "cn": "别加", "en": "Perga", "modern": "今土耳其", "ll": [36.9612, 30.8536],
    "note": "旁非利亚城市。约翰马可在此离开二人，回耶路撒冷去（徒 13:13）。" },
  { "id": "antioch-pisidia", "cn": "彼西底的安提阿", "en": "Antioch in Pisidia", "modern": "今土耳其", "ll": [38.3047, 31.1900],
    "note": "加拉太地区城市，与叙利亚的安提阿同名。保罗在此会堂留下旅程中最长的一次讲论（徒 13:16-41）。" },
  { "id": "iconium", "cn": "以哥念", "en": "Iconium", "modern": "今土耳其孔亚", "ll": [37.8746, 32.4932],
    "note": "弗吕家城市。二人住多日、倚靠主放胆讲道，后被逼离开（徒 14:1-6）。" },
  { "id": "lystra", "cn": "路司得", "en": "Lystra", "modern": "今土耳其", "ll": [37.5833, 32.4500],
    "note": "加拉太南部小城。生来瘸腿者在此得医治，保罗也在此被石头打（徒 14:8-19）；少年提摩太的家乡。" },
  { "id": "derbe", "cn": "特庇", "en": "Derbe", "modern": "今土耳其", "ll": [37.3442, 33.2772],
    "note": "第一次旅程所到最远处。二人于此传福音、教导了好些人（徒 14:21）。" },
  { "id": "jerusalem", "cn": "耶路撒冷", "en": "Jerusalem", "modern": "今以色列 / 巴勒斯坦", "ll": [31.7683, 35.2137],
    "note": "犹太教与初期教会的中心。耶路撒冷会议在此裁定外邦信徒的规矩（徒 15 章）。" },
  { "id": "tarsus", "cn": "大数", "en": "Tarsus", "modern": "今土耳其", "ll": [36.9167, 34.8833], "ctx": true,
